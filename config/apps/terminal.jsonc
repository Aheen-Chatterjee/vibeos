{
  // Windows Terminal profile.
  //
  // XAML coexistence (2026-09-06 finding): Terminal's UI consumes the pad
  // natively — Windows translates sticks/buttons into VK_GAMEPAD_* keys and
  // XAML does its own XY focus navigation + A-invoke. VibeOS bindings for A
  // and B would double-fire with the native behaviour, so they are swallowed
  // here ("none") and the pad drives Terminal directly. LB/RB chords have no
  // native equivalent and keep working through VibeOS.
  "name": "Terminal",
  "match": {
    "process": ["WindowsTerminal.exe", "wt.exe"]
  },
  "bindings": {
    "A": "none",
    "B": "none",
    "RB+A": { "key": "CTRL+SHIFT+T" },
    "RB+DpadRight": "next-tab",
    "RB+DpadLeft": "prev-tab",
    "RB+X": { "key": "CTRL+SHIFT+F" }
  },
  "wheel": {
    "name": "Terminal",
    "slots": [
      { "label": "New tab", "key": "CTRL+SHIFT+T" },
      { "label": "Next tab", "action": "next-tab" },
      { "label": "Prev tab", "action": "prev-tab" },
      { "label": "Find", "key": "CTRL+SHIFT+F" },
      { "label": "Copy", "action": "copy" },
      { "label": "Paste", "action": "paste" },
      { "label": "Select all", "action": "select-all" },
      { "label": "Desktop", "action": "show-desktop" }
    ]
  }
}
