{
  // VibeOS global bindings (PRD §19, §56). Chord grammar: "MODIFIER+TRIGGER",
  // e.g. "LB+X". Trigger is the last token. Case-insensitive.
  //
  // Binding values accept three forms:
  //   "LB+X": "copy"                                → built-in action id
  //   "RB+B": { "key": "CTRL+P" }                   → raw key gesture
  //   "LB+Y": { "action": "undo", "mode": "Release" } → action + activation mode
  //
  // Modes: Press (default), Release (tap only — press duration under the hold
  // threshold), Hold, DoubleTap. LB+RB two-modifier chords are intentionally
  // absent: that layer is the radial wheel (M4.5).
  //
  // Hot reload: edit this file while VibeOS runs; malformed edits keep the
  // last-known-good bindings. Per-app overrides live in apps/*.jsonc (M7).

  // Voice: in-house GPU dictation (no external backend).
  // model: tiny.en (fastest) | base.en (default) | small.en (accuracy).
  //   Downloads once to %LOCALAPPDATA%/VibeOS/models, stays resident on GPU.
  // cleanup: polished (STT → Ollama cleanup → insert) vs instant raw.
  //   Requires Ollama running + the cleanup model pulled once:
  //   ollama pull qwen3:1.7b
  "voice": {
    "model": "base.en",
    "language": "en",
    "cleanup": true,
    "cleanupModel": "qwen3:1.7b",
    "cleanupTimeoutMs": 2500,
    "ollama": "http://localhost:11434"
  },

  // NOTE — XAML apps (Windows Terminal, Settings, Store) consume the pad
  // natively: Windows translates sticks/buttons into VK_GAMEPAD_* keys and
  // XAML does its own XY focus navigation + A-invoke. There VibeOS double-
  // drives. Coexistence rule: suspend VibeOS (L3+R3) and drive natively, or
  // override A/B to "none" in that app's profile (M7) so VibeOS stays out.
  // Classic Win32 apps (Notepad, browsers, VS Code) ignore gamepad keys and
  // are unaffected.
  "bindings": {
    // Editing (PRD §44)
    "LB+X": "copy",
    "LB+B": "paste",
    "LB+A": "select-all",
    "LB+Y": { "action": "undo", "mode": "Release" },

    // App commands
    "RB+A": "save",
    "RB+X": "find",
    "RB+B": "quick-open",
    "RB+Y": { "action": "voice-submit", "mode": "Hold" },

    // Tabs — RB+D-pad, no per-app profile needed for the basics
    "RB+DpadLeft": "prev-tab",
    "RB+DpadRight": "next-tab",

    // Base face buttons (spec §5.4a — semantic navigation deferred to V2,
    // so A/B are plain bindable actions)
    "A": "enter",
    "B": "escape"
  },

  // Radial quick menu (spec §5.9): LB+RB held ~150 ms opens wheel 1.
  // Right stick aims, D-pad Left/Right cycles wheels, release executes,
  // B cancels. Slots use the same action ids as bindings.
  // Wheel 2 ("This app") is per-app and lands in M7; an empty wheel falls
  // back to wheel 1.
  "wheels": [
    {
      "name": "Apps",
      "slots": [
        { "label": "Chrome", "action": "launch-chrome" },
        { "label": "VS Code", "action": "launch-vscode" },
        { "label": "Cursor", "action": "launch-cursor" },
        { "label": "Terminal", "action": "launch-terminal" },
        { "label": "Explorer", "action": "launch-explorer" },
        { "label": "Edge", "action": "launch-edge" },
        { "label": "Task view", "action": "task-switch" },
        { "label": "Desktop", "action": "show-desktop" }
      ]
    },
    {
      "name": "This app",
      "slots": []
    },
    {
      "name": "Edit",
      "slots": [
        { "label": "Copy", "action": "copy" },
        { "label": "Paste", "action": "paste" },
        { "label": "Select all", "action": "select-all" },
        { "label": "Undo", "action": "undo" },
        { "label": "Redo", "action": "redo" },
        { "label": "Find", "action": "find" },
        { "label": "Screenshot", "action": "screenshot" },
        { "label": "Clipboard", "action": "clipboard-history" }
      ]
    },
    {
      // Keys wheel: tap keys fire immediately; Shift/Ctrl/Win latch one-shot
      // (sticky) — the next chord or slot consumes them combined, then clears.
      // Re-tap cancels; latches expire after 10 s.
      "name": "Keys",
      "slots": [
        { "label": "Backspace", "action": "backspace" },
        { "label": "Enter", "action": "enter" },
        { "label": "Tab", "action": "tab" },
        { "label": "Esc", "action": "escape" },
        { "label": "Space", "action": "space" },
        { "label": "Shift", "action": "sticky-shift" },
        { "label": "Ctrl", "action": "sticky-ctrl" },
        { "label": "Win", "action": "sticky-win" }
      ]
    },
    {
      // Nav wheel: the navigation cluster.
      "name": "Nav",
      "slots": [
        { "label": "Up", "action": "up" },
        { "label": "Down", "action": "down" },
        { "label": "Left", "action": "left" },
        { "label": "Right", "action": "right" },
        { "label": "Home", "action": "home" },
        { "label": "End", "action": "end" },
        { "label": "PgUp", "action": "pageup" },
        { "label": "PgDn", "action": "pagedown" }
      ]
    }
  ]
}
