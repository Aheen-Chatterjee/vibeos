<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <AssemblyName>VibeOS</AssemblyName>
    <RootNamespace>VibeOS.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VibeOS.Core\VibeOS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="SDL3.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Default configuration ships beside the exe; developers editing
       vibeos-app/config/*.jsonc get hot reload when running from that dir. -->
  <ItemGroup>
    <Content Include="..\..\config\**">
      <Link>config\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- SDL3-CS is vendored as a submodule and compiled in directly. Exclude the
       binding generator and the Legacy binding, which duplicates every symbol
       in SDL3.Core.cs. -->
  <ItemGroup>
    <Compile Remove="external\SDL3-CS\GenerateBindings\**" />
    <Compile Remove="external\SDL3-CS\SDL3\SDL3.Legacy.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

</Project>
